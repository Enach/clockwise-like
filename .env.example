# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-in-production

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=change-me-in-production
# Cookie Secure attribute (PAC-20). Leave EMPTY in production: every cookie the
# backend sets (session, OAuth state) then carries Secure and is never sent over
# plain HTTP. Set to true ONLY to serve the app over plain HTTP on an address a
# browser does not treat as secure (e.g. http://192.168.1.10) during local
# development; the e2e stack and docker-compose.dev.yml set it. Any other value
# keeps Secure and is logged at startup.
PACEDAY_INSECURE_COOKIES=
# IPs/CIDRs of reverse proxies whose X-Real-IP header the backend trusts for
# per-client rate limiting (PAC-39). Empty = trust nobody.
# docker-compose.prod.yml defaults this to Docker's private pools.
TRUSTED_PROXIES=

# ── Google OAuth (calendar + sign-in) ────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost/api/auth/callback
# Production example: GOOGLE_REDIRECT_URL=https://app.example.com/api/auth/callback

# ── Calendar stand-in (test deployments only — PAC-43) ───────────────────────
# Leave BOTH empty. No production deployment sets either.
# A non-empty GOOGLE_CALENDAR_API_BASE_URL makes the server REFUSE TO START
# unless PACEDAY_ALLOW_STANDINS=true is also set. With both set, calendar
# traffic goes to that address instead of Google, every connection is limited
# to loopback/private addresses, and the server logs that it is not a
# production deployment. The address must end in /calendar/v3/ (trailing slash).
PACEDAY_ALLOW_STANDINS=
GOOGLE_CALENDAR_API_BASE_URL=

# ── Microsoft OAuth (Outlook calendar + sign-in) ─────────────────────────────
# https://portal.azure.com → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URL=http://localhost/api/auth/microsoft/callback

# ── Zoom OAuth (conferencing) ─────────────────────────────────────────────────
# https://marketplace.zoom.us/develop/create
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URL=http://localhost/api/auth/zoom/callback

# ── AI providers (NEW-llm-bring-your-own) ────────────────────────────────────
# PACEDAY SUPPLIES NO LLM CREDENTIAL. Every AI request carries an API key that
# the user entered in Settings for that provider, and nothing else that
# authenticates. There is deliberately no variable here for a key, and the
# server never reads credentials of the machine it runs on for AI (no AWS,
# Azure or Google credential chain; AWS_BEARER_TOKEN_BEDROCK is ignored).
# When a user has no key, their AI features are off and say so.
#
# Supported providers: OpenAI, Anthropic, Azure OpenAI (API key), AWS Bedrock
# (Bedrock API key) and Google Vertex AI (express-mode API key).
#
# What is configured here is only WHERE those keys may be sent. A request is
# made only to a destination approved below for the provider in use, only to
# that provider's inference operation, and redirects are never followed.
#
# Azure OpenAI, Vertex AI and Bedrock: comma-separated exact host names, or
# https://<host> as copied from a portal. No wildcards, ports, paths or IP
# addresses (such entries are logged at startup and ignored). A host approved
# for one provider is not approved for another. Unset means not enabled.
#   PACEDAY_LLM_APPROVED_HOSTS_AZURE_OPENAI=https://my-resource.openai.azure.com/
#   PACEDAY_LLM_APPROVED_HOSTS_VERTEX=aiplatform.googleapis.com
#   PACEDAY_LLM_APPROVED_HOSTS_BEDROCK=bedrock-runtime.us-east-1.amazonaws.com
# Vertex express mode uses only the global host aiplatform.googleapis.com; a
# regional <location>-aiplatform.googleapis.com entry approves nothing. An
# empty Bedrock region means us-east-1; approve that host if users leave it
# empty.
PACEDAY_LLM_APPROVED_HOSTS_AZURE_OPENAI=
PACEDAY_LLM_APPROVED_HOSTS_VERTEX=
PACEDAY_LLM_APPROVED_HOSTS_BEDROCK=

# OpenAI and Anthropic: https://api.openai.com and https://api.anthropic.com
# are always approved (a user with an empty base URL needs nothing here). List
# an OpenAI-compatible gateway or an Anthropic proxy as an exact host name,
# https://<host>, or https://<host>/<path prefix> (https only, default port).
# A user's base URL must then be exactly that host and prefix; requests go to
# <prefix>/v1/chat/completions (OpenAI) or <prefix>/v1/messages (Anthropic).
#   PACEDAY_LLM_APPROVED_HOSTS_OPENAI=https://gateway.example.com/openai
PACEDAY_LLM_APPROVED_HOSTS_OPENAI=
PACEDAY_LLM_APPROVED_HOSTS_ANTHROPIC=

# UPGRADE NOTE (NEW-llm-bring-your-own): AI stops using this deployment's own
# cloud credentials immediately. Users on Azure OpenAI, Bedrock or Vertex must
# add an API key in Settings; users on the removed local-model provider must
# choose another provider. The variable that approved local-model servers was
# removed: if your environment still sets it, the server logs at startup that
# it is no longer used and approves nothing.

# ── Slack OAuth (meeting briefs + daily recap) ───────────────────────────────
# https://api.slack.com/apps → Create App → OAuth & Permissions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost/api/integrations/slack/callback

# ── Notion OAuth (meeting briefs) ─────────────────────────────────────────────
# https://www.notion.so/my-integrations → New Integration → OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost/api/integrations/notion/callback

# ── MCP Server ───────────────────────────────────────────────────────────────
# Optional bearer token to protect the SSE endpoint (leave empty for open access)
MCP_AUTH_TOKEN=

# ── TLS (production only) ────────────────────────────────────────────────────
# Path to directory containing Let's Encrypt certificates
TLS_CERT_DIR=/etc/letsencrypt

# ── Sentry (error/exception monitoring — backend) ────────────────────────────
# DSN for the backend Sentry project. A Sentry ingest DSN is a client-side
# identifier (not a classic secret). Leave empty to disable monitoring — init is
# non-fatal and the server still boots ("monitoring disabled"). Unsetting this in
# a running environment is also the runtime kill switch (no code deploy needed).
SENTRY_DSN=https://4383608feea22d8fe1b1bb0c4a922ab1@o4512081160896512.ingest.de.sentry.io/4512083547062352
# Environment tag attached to events (development / staging / production).
SENTRY_ENVIRONMENT=development
# Release identifier for attribution; set by CI, leave empty locally.
SENTRY_RELEASE=
