#!/usr/bin/env bash
set -euo pipefail

YELLOW='\033[0;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

fail() { echo -e "${RED}✗ $*${NC}" >&2; exit 1; }
ok()   { echo -e "${GREEN}✓ $*${NC}"; }
info() { echo -e "${YELLOW}» $*${NC}"; }

ROOT="$(git rev-parse --show-toplevel)"

# Only check files that are staged
changed_dirs() {
  git diff --cached --name-only | grep -E "^$1/" | head -1
}

# ── Backend ───────────────────────────────────────────────────────────────────
if changed_dirs backend || changed_dirs "backend/.*"; then
  info "backend: build"
  (cd backend && go build ./...) || fail "backend build failed"
  ok "backend build"

  if command -v golangci-lint &>/dev/null; then
    info "backend: lint"
    (cd backend && golangci-lint run --config ../.golangci.yml --fast) || fail "backend lint failed"
    ok "backend lint"
  else
    echo "  (golangci-lint not found — skipping backend lint)"
  fi
fi

# ── MCP ───────────────────────────────────────────────────────────────────────
if changed_dirs mcp; then
  info "mcp: build"
  (cd mcp && GONOSUMDB='*' GOFLAGS='-mod=mod' go build ./...) || fail "mcp build failed"
  ok "mcp build"

  if command -v golangci-lint &>/dev/null; then
    info "mcp: lint"
    (cd mcp && GONOSUMDB='*' GOFLAGS='-mod=mod' golangci-lint run --config ../.golangci.yml --fast) || fail "mcp lint failed"
    ok "mcp lint"
  else
    echo "  (golangci-lint not found — skipping mcp lint)"
  fi
fi

# ── Contract ──────────────────────────────────────────────────────────────────
# A committed bundle that does not match its fragments, or generated code that
# does not match the bundle, is the one failure mode the whole factory is built
# to prevent — and it is cheap to catch here rather than in `make verify`.
#
# WEB= deliberately empties the web repo path: this hook gates *this* repo, and
# regenerating the sibling frontend would need its node_modules installed. The
# cross-repo half of factory §2 gate 4 runs in `make verify`.
if changed_dirs contracts || changed_dirs "backend/api/gen"; then
  info "contract: openapi-check"
  make -f "$ROOT/Makefile" WEB= openapi-check || fail "openapi-check failed — run \`make openapi\` and stage the result"
  ok "contract in sync"
fi
