# The OpenAPI contract is generated and gated byte-for-byte; keep it LF on every
# platform so core.autocrlf=true checkouts never look out of date.
contracts/openapi/** text eol=lf

# Same for the generated Go client: openapi_gen_go.sh writes LF and diffs the
# result byte-for-byte against this file.
backend/api/gen/*.gen.go text eol=lf

# PAC-81 Part B: nginx/paceday-render.sh runs under /bin/sh in the container;
# a CRLF checkout (core.autocrlf=true) would break it.
nginx/** text eol=lf

# Shell scripts run under bash or sh; CRLF breaks them (PAC-81 Part D). This
# covers scripts/ops/*.sh and every other *.sh in the repository.
*.sh text eol=lf
